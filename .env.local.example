# Copiez ce fichier vers .env.local pour le développement local.
# Exécution FastAPI directement depuis l’hôte :
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/apprendiamo_db

# Exécution avec docker compose : la valeur utilisée est DATABASE_URL_DOCKER.
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:admin@db:5432/apprendiamo_db

DB_MAX_RETRIES=30
DB_RETRY_DELAY=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Variables optionnelles de développement uniquement.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAGNIFIC_API_KEY=
SECRET_KEY=change-this-local-development-secret
