# Valeurs à configurer dans Vercel. Ne stockez pas de secrets de production dans Git.
DATABASE_URL=postgresql+asyncpg://user:password@host/database?ssl=require
# Miroir Supabase via transaction pooler ; à renseigner dans Vercel comme secret.
SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres.project-ref:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_MAX_RETRIES=5
DB_RETRY_DELAY=1
DB_CREATE_TABLES=0
CORS_ORIGINS=https://bella-design-lab.vercel.app

# Client ID public de l'application Google Identity Services.
# Le backend vérifie les ID tokens ; aucun client secret n'est utilisé par ce flux.
GOOGLE_CLIENT_ID=

# Autres variables optionnelles.
MAGNIFIC_API_KEY=
# OBLIGATOIRE : configurer SECRET_KEY dans Vercel Production et conserver sa valeur actuelle.
# Elle signe les JWT et les liens QR publics ; ne pas la faire tourner sans plan de transition.
SECRET_KEY=

# Stockage médias Vercel Blob — injectés automatiquement par la connexion du store.
# Ne définissez pas VERCEL_OIDC_TOKEN manuellement : Vercel le renouvelle à l’exécution.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
# Repli seulement pour un script externe ; ne jamais exposer ce jeton au frontend.
BLOB_READ_WRITE_TOKEN=
BLOB_MAX_UPLOAD_BYTES=4194304
# Secret distinct, uniquement employé lors de l’exécution ponctuelle de la migration par lots.
MEDIA_MIGRATION_TOKEN=
