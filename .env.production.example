# Valeurs à configurer dans Vercel. Ne stockez pas de secrets de production dans Git.
DATABASE_URL=postgresql+asyncpg://user:password@host/database?ssl=require
DB_MAX_RETRIES=5
DB_RETRY_DELAY=1
CORS_ORIGINS=https://bella-design-lab.vercel.app

# Renseigner uniquement si les fonctionnalités concernées sont activées.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAGNIFIC_API_KEY=
SECRET_KEY=

# Stockage médias Vercel Blob — injectés automatiquement par la connexion du store.
# Ne définissez pas VERCEL_OIDC_TOKEN manuellement : Vercel le renouvelle à l’exécution.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
# Repli seulement pour un script externe ; ne jamais exposer ce jeton au frontend.
BLOB_READ_WRITE_TOKEN=
BLOB_MAX_UPLOAD_BYTES=4194304
# Secret distinct, uniquement employé lors de l’exécution ponctuelle de la migration par lots.
MEDIA_MIGRATION_TOKEN=
