# Consultez .env.local.example pour le développement et .env.production.example pour Vercel.
DATABASE_URL=postgresql+asyncpg://user:password@host/database?ssl=require
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:admin@db:5432/apprendiamo_db
DB_MAX_RETRIES=5
DB_RETRY_DELAY=1
CORS_ORIGINS=http://localhost:5173

# Variables optionnelles : ne placez jamais de secrets de production dans Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAGNIFIC_API_KEY=
SECRET_KEY=

# Médias flashcards : en Vercel, BLOB_STORE_ID et VERCEL_OIDC_TOKEN sont injectés par la connexion du store.
# En local, utilisez uniquement BLOB_READ_WRITE_TOKEN dans .env.local.
BLOB_READ_WRITE_TOKEN=
BLOB_MAX_UPLOAD_BYTES=4194304
MEDIA_MIGRATION_TOKEN=
